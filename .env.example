# Copy to `.env` for local dev. Vite only exposes variables prefixed with `VITE_`.
# For production, set the same keys in EdgeOne build settings.
#
# Local API (optional): run `npm run dev:api` + `npm run dev:local` instead of `npm run dev`
# to hit a bundled make-server on localhost:8787 (see README.md § Local Development).

# --- Tencent CloudBase (frontend) — current NEXA env (Singapore / intl) ---
VITE_CLOUDBASE_ENV_ID=nexa-mm-i0goiaxufc1521e43
VITE_CLOUDBASE_REGION=ap-singapore
# HTTP function base (must end with /make-server-16010b6f). Production uses the Singapore app host:
VITE_CLOUDBASE_API_BASE_URL=https://nexa-mm-i0goiaxufc1521e43-1446771428.ap-singapore.app.tcloudbase.com/make-server-16010b6f
# Alternate gateway form (also valid):
# VITE_CLOUDBASE_API_BASE_URL=https://nexa-mm-i0goiaxufc1521e43.api.tcloudbasegateway.com/v1/functions/make-server-16010b6f
VITE_CLOUDBASE_PUBLISHABLE_KEY=
VITE_CLOUDBASE_THUMB_MAX=256
# Vendor subdomain suffix (no protocol). Current production: nexa-mm.com
VITE_VENDOR_SUBDOMAIN_BASE_DOMAIN=nexa-mm.com
# Comma-separated marketplace apex hosts (branding landing at /). Add every production
# apex you point at EdgeOne.
VITE_PLATFORM_RESERVED_APEX_DOMAINS=nexa-mm.com,nexa-apex.online
VITE_DEPLOYMENT_PLATFORM=tencent-cloudbase

# --- TencentDB (schema migration + Supabase import scripts) ---
# URL-encode special characters in passwords. Managed TencentDB often uses a custom port (e.g. 23100).
# Current linked instance host pattern: sg-postgres-jwchnpet.sql.tencentcdb.com:23100
# TENCENT_DATABASE_URL=postgresql://user:PASSWORD@sg-postgres-jwchnpet.sql.tencentcdb.com:23100/postgres
# SOURCE_POSTGRES_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# --- CloudBase function env (set in TCB console, see cloudbase/function-env.template.env) ---
# CLOUDBASE_ENV_ID=nexa-mm-i0goiaxufc1521e43
# CLOUDBASE_REGION=ap-singapore
# CLOUDBASE_SERVICE_TOKEN=
# CLOUDBASE_PUBLISHABLE_KEY=
# CLOUDBASE_API_BASE_URL=
# CLOUDBASE_API_PUBLIC_BASE_URL=   # required for KV-stored image signed URLs in browsers
# CLOUDBASE_STORAGE_API_BASE_URL=  # optional; unset = store uploads in TencentDB KV (NEXA default)
# EDGE_ADMIN_OPERATION_SECRET=
# TENCENT_POSTGREST_URL=   # auto-defaults from CLOUDBASE_ENV_ID when unset on function
#
# Password reset email (Tencent SES) — required on make-server-16010b6f:
# TENCENT_SECRET_ID= TENCENT_SECRET_KEY= TENCENT_SES_FROM_EMAIL=
# TENCENT_SES_REGION=ap-singapore TENCENT_SES_PASSWORD_RESET_TEMPLATE_ID=
#
# Phone OTP for customer registration (Tencent SMS) — optional; see function-env.template.env:
# TENCENT_SMS_SDK_APP_ID= TENCENT_SMS_SIGN_NAME= TENCENT_SMS_REGISTER_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-singapore

# --- Admin destructive operations (optional) ---
# VITE_ADMIN_OPERATION_SECRET=

# --- Payments (optional; Stripe not wired to vendor Checkout) ---
# VITE_STRIPE_PUBLISHABLE_KEY=

# Quick start (empty DB + function zips):
#   npm run setup:tcb-first
# Console guide:
#   docs/TCB_CONSOLE_SETUP.md
# Import Supabase data (excludes kpay txn/draft + chat):
#   npm run import:supabase-data
# Test DB connections:
#   npm run test:db
